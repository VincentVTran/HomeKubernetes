# Copy to .env (git ignores it) and fill in. Scripts read it as ../.env from their folder.
# Secrets in here reach kubectl only through files and pipes, never on a command line.

# --- Cloudflare Tunnel (read by CloudflareTunnel/install-cloudflared.sh) ------------------------------------------------
# Path to the tunnel's credentials file: a path, not the secret itself (~ is allowed).
# How to get it, on your laptop with cloudflared installed (https://github.com/cloudflare/cloudflared/releases):
#   cloudflared tunnel login          # browser: pick vtranlabs.com; writes ~/.cloudflared/cert.pem
#   cloudflared tunnel create home    # prints the tunnel id and writes ~/.cloudflared/<tunnel-id>.json
# The tunnel already exists? `cloudflared tunnel list` shows its id; the .json is on the machine that created it.
# If that file is lost, there's no way to download it again: run `cloudflared tunnel delete home`, then create the tunnel again
# and rerun `cloudflared tunnel route dns home rental.vtranlabs.com` (see CloudflareTunnel/README.md).
CLOUDFLARE_TUNNEL_CREDENTIALS=~/.cloudflared/<tunnel-id>.json

# --- Optional: Grafana admin password, for your own reference -----------------------------------------------------------
# No script reads this. Grafana's login lives in the Secret grafana-admin (see GrafanaService/README.md). Read it back with:
#   kubectl get secret grafana-admin --namespace grafana -o jsonpath='{.data.admin-password}' | base64 -d
GRAFANA_PASSWORD=
