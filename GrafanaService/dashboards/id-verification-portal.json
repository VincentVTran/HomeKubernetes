{
  "uid": "id-verification-portal",
  "title": "ID verification portal",
  "description": "Requests, errors and slow requests of the ID verification portal, and its recent error logs with reference codes. Provisioned from HomeKubernetes/GrafanaService/dashboards; edit the file, not this dashboard.",
  "tags": [
    "id-verification-portal"
  ],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus Server",
          "value": "Prometheus Server"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace (logs)",
        "type": "textbox",
        "query": "id-verification-portal",
        "current": {
          "text": "id-verification-portal",
          "value": "id-verification-portal"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate per route",
      "description": "Requests per second, by route template.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{exported_job=~\"(.+/)?id-verification-portal\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate per route",
      "description": "Share of requests answered with a 5xx status, by route template.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "(sum by (http_route) (rate(http_server_request_duration_seconds_count{exported_job=~\"(.+/)?id-verification-portal\", http_response_status_code=~\"5..\"}[$__rate_interval])) or sum by (http_route) (rate(http_server_request_duration_seconds_count{exported_job=~\"(.+/)?id-verification-portal\"}[$__rate_interval])) * 0) / sum by (http_route) (rate(http_server_request_duration_seconds_count{exported_job=~\"(.+/)?id-verification-portal\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency per route",
      "description": "95th percentile of request duration, by route template.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (http_route, le) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"(.+/)?id-verification-portal\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent errors",
      "description": "The latest error log lines (severity error or worse) from the portal's pods. The reference code is what the Applicant Page and Admin Page show; click it to open the trace.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "k8s.namespace.name:=\"$namespace\" severity_number:>=17 | extract_regexp \"^(?P<reference>[0-9a-f]{8})\" from trace_id | sort by (_time desc) | limit 100 | fields _time, reference, _msg, trace_id",
          "maxLines": 100
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "jsonPaths": [
              {
                "path": "reference"
              }
            ],
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "id": true,
              "streams": true,
              "streamId": true,
              "detected_level": true
            },
            "indexByName": {
              "Time": 0,
              "reference": 1,
              "Line": 2,
              "trace_id": 3
            },
            "renameByName": {
              "Time": "Time",
              "Line": "Message",
              "reference": "Reference"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reference"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "",
                    "internal": {
                      "datasourceUid": "victoriatraces",
                      "datasourceName": "VictoriaTraces",
                      "query": {
                        "query": "${__data.fields.trace_id}"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent logs",
      "description": "The latest log lines from the portal's pods at every level except debug: one line per request (method, route, status), plus anything else the server writes. Lines the server wrote outside its logger (for example Node's warnings, or a crash's stack trace) show as Unspecified. Click a reference code to open the request's trace.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "editorMode": "code",
          "queryType": "instant",
          "expr": "k8s.namespace.name:=\"$namespace\" -severity_text:=\"debug\" | extract_regexp \"^(?P<reference>[0-9a-f]{8})\" from trace_id | sort by (_time desc) | limit 200 | fields _time, severity_text, reference, _msg, trace_id",
          "maxLines": 200
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "jsonPaths": [
              {
                "path": "reference"
              },
              {
                "path": "severity_text"
              }
            ],
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "id": true,
              "streams": true,
              "streamId": true,
              "detected_level": true
            },
            "indexByName": {
              "Time": 0,
              "severity_text": 1,
              "reference": 2,
              "Line": 3,
              "trace_id": 4
            },
            "renameByName": {
              "Time": "Time",
              "severity_text": "Level",
              "Line": "Message",
              "reference": "Reference"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reference"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View trace",
                    "url": "",
                    "internal": {
                      "datasourceUid": "victoriatraces",
                      "datasourceName": "VictoriaTraces",
                      "query": {
                        "query": "${__data.fields.trace_id}"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "severity_text"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "info": {
                        "color": "text",
                        "index": 0
                      },
                      "warn": {
                        "color": "orange",
                        "index": 1
                      },
                      "error": {
                        "color": "red",
                        "index": 2
                      },
                      "Unspecified": {
                        "color": "purple",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    }
  ]
}
