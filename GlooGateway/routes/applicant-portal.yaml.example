# Example only, so `kubectl apply -f ./routes` skips it: copy it to a .yaml file to use it. Sends a public https domain to the
# Applicant Portal. Its PUBLIC_BASE_URL must be this same https address. The Service name
# below assumes the chart was installed as release `applicant-portal` in namespace `applicant-portal`.
apiVersion: gateway.solo.io/v1
kind: VirtualService
metadata:
  name: applicant-portal
  namespace: gloo-system
  labels:
    exposure: external
spec:
  virtualHost:
    domains:
      - 'portal.example.com'
    routes:
      - matchers:
        - prefix: /
        routeAction:
          single:
            kube:
              ref:
                name: applicant-portal
                namespace: applicant-portal
              port: 80
